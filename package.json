{
	"name": "decision-router",
	"version": "0.1.1",
	"description": "Pick the right LLM for each prompt with a calibrated decision model (TypeSafe Jev). CLI, Claude Code plugin and Pi extension.",
	"license": "MIT",
	"author": "Rui Valim",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ruivalim/decision-router.git"
	},
	"homepage": "https://github.com/Ruivalim/decision-router#readme",
	"bugs": {
		"url": "https://github.com/Ruivalim/decision-router/issues"
	},
	"type": "module",
	"bin": {
		"decision-router": "dist/cli.js"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20.3"
	},
	"keywords": [
		"llm",
		"router",
		"model-router",
		"claude-code",
		"pi-package",
		"typesafe",
		"jev"
	],
	"pi": {
		"extensions": [
			"./dist/pi.js"
		]
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run typecheck && bun test && bun run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@earendil-works/pi-ai": "^1.0.2",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@types/bun": "latest",
		"typescript": "^7"
	}
}
